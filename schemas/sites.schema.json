{
  "$defs": {
    "ExternalLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "ExternalLink",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "SiteFeature": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "discriminator": {
            "mapping": {
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/SiteProperties"
        },
        "type": {
          "const": "Feature",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "title": "SiteFeature",
      "type": "object"
    },
    "SiteProperties": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "country": {
          "pattern": "^[A-Z]{3}$",
          "title": "Country",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/ExternalLink"
          },
          "title": "Links",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "name_local": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Local"
        },
        "osm_ids": {
          "items": {
            "pattern": "^(node|way|relation)/[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Osm Ids",
          "type": "array"
        },
        "sensors": {
          "enum": [
            "both",
            "radar_only"
          ],
          "title": "Sensors",
          "type": "string"
        },
        "site_type": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Site Type",
          "type": "string"
        },
        "sources": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Status",
          "type": "string"
        },
        "tags": {
          "patternProperties": {
            "^[a-z0-9]+(?:[_-][a-z0-9]+)*$": {
              "items": {
                "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Tags",
          "type": "object"
        },
        "wikidata": {
          "anyOf": [
            {
              "pattern": "^Q[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wikidata"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "minItems": 1,
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "country",
        "site_type",
        "status",
        "sources",
        "as_of",
        "zones",
        "sensors"
      ],
      "title": "SiteProperties",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "exclusion_masks": {
          "items": {
            "discriminator": {
              "mapping": {
                "MultiPolygon": "#/$defs/MultiPolygon",
                "Polygon": "#/$defs/Polygon"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Polygon"
              },
              {
                "$ref": "#/$defs/MultiPolygon"
              }
            ]
          },
          "title": "Exclusion Masks",
          "type": "array"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Geometry"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "indicator_overrides": {
          "patternProperties": {
            "^[a-z0-9]+(?:[_-][a-z0-9]+)*$": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            }
          },
          "title": "Indicator Overrides",
          "type": "object"
        },
        "sources": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "water_mask": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "MultiPolygon": "#/$defs/MultiPolygon",
                  "Polygon": "#/$defs/Polygon"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Polygon"
                },
                {
                  "$ref": "#/$defs/MultiPolygon"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Water Mask"
        },
        "zone_type": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Zone Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "zone_type",
        "geometry",
        "sources"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "features": {
      "items": {
        "$ref": "#/$defs/SiteFeature"
      },
      "title": "Features",
      "type": "array"
    },
    "type": {
      "const": "FeatureCollection",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "features"
  ],
  "title": "SitesFile",
  "type": "object"
}
